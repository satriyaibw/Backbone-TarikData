# Streamlit secrets — TEMPLATE (copy ke secrets.toml lalu generate hash)
# JANGAN commit secrets.toml (sudah .gitignore)
# Generate via: python scripts/generate_auth_secrets.py --password 'YourStrongPass!'
# atau isi AUTH_PASSWORD di .env lalu: python scripts/generate_auth_secrets.py --force

[auth]
cookie_name = "karangasem_auth"
cookie_key = "GANTI_DENGAN_RANDOM_64_HEX_dari_generate"
cookie_expiry_days = 1.0

[credentials]
[credentials.usernames.admin]
name = "Admin Karangasem"
email = "admin@pendidikan.karangasemkab.go.id"
password = "$2b$12$GANTI_DENGAN_BCRYPT_HASH"
